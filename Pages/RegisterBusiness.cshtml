@page
@{
    Layout = null;
    ViewData["Title"] = "Register as Vet / Shop — All For Pets";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register as Vet or Shop — All For Pets</title>
    <meta name="description" content="Apply to list your veterinary clinic or pet-supply shop on the All For Pets Municipal Portal. Get discovered by pet owners in your city." />
    <link rel="stylesheet" href="~/css/afp.css" />
    <style>
        body { background: linear-gradient(180deg,#FFF3E8 0%,#FFFFFF 100%); min-height: 100vh; }
        .rb-wrap { max-width: 560px; margin: 0 auto; padding: 32px 20px 48px; }
        .rb-hdr  { text-align: center; margin-bottom: 22px; }
        .rb-hdr .brand { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #E8670A; font-weight: 700; }
        .rb-hdr h1 { font-size: 26px; margin: 6px 0 4px; color: #1A1814; }
        .rb-hdr p  { color: #5A564F; font-size: 14px; margin: 0; }
        .rb-card { background: #fff; border-radius: 18px; box-shadow: 0 6px 24px rgba(0,0,0,.05); padding: 22px; margin-bottom: 14px; }
        .rb-type-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
        .rb-type-btn { border: 1.5px solid #E5E0D8; background: #fff; border-radius: 12px; padding: 14px 12px; text-align: center; cursor: pointer; font-weight: 700; color: #5A564F; }
        .rb-type-btn.active { border-color: #E8670A; background: #FFF3E8; color: #E8670A; }
        .rb-fee-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: #FEF3C7; border: 1px solid #FBBF24; border-radius: 10px; font-size: 13px; margin-bottom: 14px; color: #92400E; font-weight: 600; }
        .rb-step { display: none; }
        .rb-step.active { display: block; }
        .rb-step-dots { display: flex; gap: 8px; justify-content: center; margin-bottom: 20px; }
        .rb-step-dot { width: 10px; height: 10px; border-radius: 50%; background: #E5E0D8; }
        .rb-step-dot.active { background: #E8670A; }
        .rb-step-dot.done { background: #16A34A; }
        .rb-btns { display: flex; gap: 10px; margin-top: 14px; }
        .rb-btns button { flex: 1; }
        .rb-note { font-size: 12px; color: #5A564F; margin-top: 8px; }
        .rb-alert { padding: 10px 12px; border-radius: 8px; font-size: 13px; margin-bottom: 12px; display: none; }
        .rb-alert.err { background: #FEE2E2; color: #991B1B; }
        .rb-alert.ok  { background: #D1FAE5; color: #065F46; }
        .rb-alert.info{ background: #DBEAFE; color: #1E40AF; }
    </style>
</head>
<body>
<div class="rb-wrap">
<div class="rb-hdr">
    <div class="brand">🐾 All For Pets</div>
    <h1>List your practice on the portal</h1>
    <p>Get discovered by pet owners in your city. Verified vets and shops only.</p>
</div>

<div id="rb-form-wrap">
        <div class="rb-step-dots">
            <span class="rb-step-dot active" id="dot-1"></span>
            <span class="rb-step-dot"        id="dot-2"></span>
            <span class="rb-step-dot"        id="dot-3"></span>
            <span class="rb-step-dot"        id="dot-4"></span>
        </div>

        <div id="rb-alert" class="rb-alert"></div>

        <!-- STEP 1: Type + basic details -->
        <div class="rb-step active" id="rb-step-1">
            <div class="rb-card">
                <div style="font-weight:700;font-size:15px;margin-bottom:10px">1. What are you registering?</div>
                <div class="rb-type-row">
                    <button type="button" class="rb-type-btn active" data-type="doctor" onclick="setType('doctor')">
                        🩺<br>Veterinary Doctor
                    </button>
                    <button type="button" class="rb-type-btn" data-type="shop" onclick="setType('shop')">
                        🛒<br>Pet-supply Shop
                    </button>
                </div>

                <div class="rb-fee-bar" style="background:#FEF3C7;border-color:#FBBF24;color:#92400E">
                    <span>🚫 Registration fee</span>
                    <span>Temporarily disabled &mdash; free to apply</span>
                </div>

                <div class="field">
                    <label class="field-label" id="f-name-label">Your full name *</label>
                    <input id="f-name" class="field-input" placeholder="e.g. Dr. Anita Sharma" />
                </div>
                <div class="field">
                    <label class="field-label">Contact mobile *</label>
                    <input id="f-mobile" class="field-input" type="tel" maxlength="10" placeholder="10-digit mobile" />
                    <div class="rb-note" style="margin-top:4px">Also used as your login ID.</div>
                </div>
                <div class="field">
                    <label class="field-label">Email *</label>
                    <input id="f-email" class="field-input" type="email" placeholder="you@example.com" />
                    <div class="rb-note" style="margin-top:4px">We'll send approval / rejection updates here.</div>
                </div>
                <div class="field">
                    <label class="field-label">Create a password *</label>
                    <input id="f-password" class="field-input" type="password" autocomplete="new-password" placeholder="Min 8 chars, at least 1 letter + 1 digit" />
                    <div class="rb-note" style="margin-top:4px">You'll use this + your mobile to log in later and manage your listing.</div>
                </div>

                <!-- Doctor-only -->
                <div id="doc-fields">
                    <div class="field">
                        <label class="field-label">Qualification *</label>
                        <input id="f-qual" class="field-input" placeholder="e.g. BVSc &amp; AH, MVSc" />
                    </div>
                    <div class="field">
                        <label class="field-label">Specialization</label>
                        <input id="f-spec" class="field-input" placeholder="e.g. Small animals, Surgery" />
                    </div>
                    <div class="field">
                        <label class="field-label">Clinic name</label>
                        <input id="f-clinic" class="field-input" placeholder="e.g. Petology Clinic" />
                    </div>
                </div>

                <!-- Shop-only -->
                <div id="shop-fields" style="display:none">
                    <div class="field">
                        <label class="field-label">Owner name</label>
                        <input id="f-owner" class="field-input" placeholder="Proprietor name" />
                    </div>
                    <div class="field">
                        <label class="field-label">Speciality</label>
                        <input id="f-speciality" class="field-input" placeholder="Dry food, grooming supplies, aquariums…" />
                    </div>
                </div>

                <div class="field">
                    <label class="field-label">Address</label>
                    <input id="f-address" class="field-input" placeholder="Shop no., street, area" />
                </div>
                <div class="field">
                    <label class="field-label">Opening hours</label>
                    <input id="f-timings" class="field-input" placeholder="e.g. Mon–Sat 10 AM – 8 PM" />
                </div>
                <div class="field">
                    <label class="field-label">Licence / registration number</label>
                    <input id="f-licence" class="field-input" placeholder="VCI reg. no. / GST / Udyam / Shop Act no." />
                </div>

                <div class="rb-btns">
                    <button class="btn btn-primary" onclick="submitApply()">Create account &amp; continue →</button>
                </div>
                <div class="rb-note">
                    We'll create your account and application together. Already have an account?
                    <a href="/" style="color:#E8670A;font-weight:600">Log in first</a>, then come back here — the form will detect you and skip account creation.
                </div>
            </div>
        </div>

        <!-- STEP 2: Doc upload -->
        <div class="rb-step" id="rb-step-2">
            <div class="rb-card">
                <div style="font-weight:700;font-size:15px;margin-bottom:6px">2. Upload verification document</div>
                <div class="rb-note" style="margin:0 0 12px">
                    Vets: BVSc/MVSc certificate or VCI registration.<br>
                    Shops: GST certificate, Udyam registration, or Shop Act licence.<br>
                    Max 10 MB. JPG / PNG / PDF.
                </div>
                <div class="field">
                    <input id="f-doc" type="file" accept="image/*,application/pdf" class="field-input" />
                </div>
                <div class="rb-btns">
                    <button class="btn btn-outline" onclick="gotoStep(1)">← Back</button>
                    <button class="btn btn-primary" onclick="uploadDoc()">Upload &amp; submit →</button>
                </div>
            </div>
        </div>

        <!-- STEP 3: Payment (temporarily disabled — mirrors pet-registration flow) -->
        <div class="rb-step" id="rb-step-3">
            <div class="rb-card">
                <div style="font-weight:700;font-size:15px;margin-bottom:6px">3. Payment</div>
                <div class="rb-alert info" style="display:block">
                    🚫 Payment is temporarily disabled. Your application will be submitted directly for Super Admin review — no registration fee is charged right now.
                </div>
                <div class="rb-btns">
                    <button class="btn btn-outline" onclick="gotoStep(2)">← Back</button>
                    <button class="btn btn-primary" onclick="skipPayment()">Submit application →</button>
                </div>
            </div>
        </div>

        <!-- STEP 4: Done -->
        <div class="rb-step" id="rb-step-4">
            <div class="rb-card" style="text-align:center">
                <div style="font-size:44px">✅</div>
                <div style="font-weight:800;font-size:18px;margin-top:6px">Application submitted!</div>
                <div class="rb-note" style="margin-top:8px">
                    We'll review your documents within 2 – 3 working days.
                    You'll get an email at the address on your account.
                </div>
                <a href="/" class="btn btn-primary" style="display:inline-block;margin-top:14px">Back to home →</a>
            </div>
        </div>
    </div>
</div>

<script src="~/js/afp-core.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
(function () {
const API_BASE = ""; // relative — everything routes through the .NET proxy

// ── Signup-in-place ──────────────────────────────────────────────────
// No auth gate. If the visitor is already logged in we hide the email +
// password fields (they'll go through the existing authenticated /apply
// flow), otherwise the form calls the new public /register endpoint that
// creates the citizen account + draft application atomically.
const _alreadyAuthed = !!AFP.getToken();
if (_alreadyAuthed) {
    // Hide credential fields — the applicant is already a user.
    ["f-email", "f-password"].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.closest(".field").style.display = "none";
    });
}

// ── State ─────────────────────────────────────────────────────────────
let _type    = "doctor";
let _fee     = null;    // ₹ registration fee
let _appId   = null;    // application row id after step 1

    // ── Fetch current platform fee for the selected type ────────────────
    // Payment is temporarily disabled, but we still fetch the fee so it can
    // be re-enabled later by re-adding the fee bar + payNow() step 3 handler.
    async function loadFee() {
        const feeType = _type === "doctor" ? "doctor_registration" : "shop_registration";
        try {
            const r = await AFP.GET(`/api/platform-fees/resolve?feeType=${feeType}`);
            _fee = r.amount;
        } catch { _fee = _type === "doctor" ? 500 : 300; }
        const feeEl    = document.getElementById("rb-fee");
        const feePayEl = document.getElementById("rb-fee-pay");
        if (feeEl)    feeEl.textContent    = _fee;
        if (feePayEl) feePayEl.textContent = _fee;
    }

    // ── UI helpers ───────────────────────────────────────────────────────
    function alert(kind, msg) {
        const el = document.getElementById("rb-alert");
        el.className = "rb-alert " + kind;
        el.textContent = msg;
        el.style.display = "block";
        setTimeout(() => { el.style.display = "none"; }, kind === "err" ? 6000 : 3500);
    }

    window.setType = function (t) {
        _type = t;
        document.querySelectorAll(".rb-type-btn").forEach(b =>
            b.classList.toggle("active", b.dataset.type === t));
        document.getElementById("doc-fields").style.display  = t === "doctor" ? "" : "none";
        document.getElementById("shop-fields").style.display = t === "shop"   ? "" : "none";
        // Re-label the top "name" field so it's not a duplicate of the
        // type-specific fields below (Clinic name for doctors, Shop name
        // for shops). For doctors we ask for the vet's personal name; for
        // shops the top field IS the shop's business name.
        const lbl = document.getElementById("f-name-label");
        const nameInput = document.getElementById("f-name");
        if (t === "doctor") {
            lbl.textContent = "Your full name *";
            nameInput.placeholder = "e.g. Dr. Anita Sharma";
        } else {
            lbl.textContent = "Shop / business name *";
            nameInput.placeholder = "e.g. Happy Tails Pet Store";
        }
        loadFee();
    };

    window.gotoStep = function (n) {
        for (let i = 1; i <= 4; i++) {
            document.getElementById(`rb-step-${i}`).classList.toggle("active", i === n);
            const dot = document.getElementById(`dot-${i}`);
            dot.classList.toggle("active", i === n);
            dot.classList.toggle("done",   i <  n);
        }
        window.scrollTo(0, 0);
    };

    // ── Step 1 → create account (if needed) + draft application ─────────
    window.submitApply = async function () {
        const name   = document.getElementById("f-name").value.trim();
        const mobile = document.getElementById("f-mobile").value.trim();
        if (!name) return alert("err", "Business / clinic name is required.");
        if (!/^[6-9]\d{9}$/.test(mobile)) return alert("err", "Enter a valid 10-digit mobile number.");

        // Extra validation for the signup-in-place path.
        let email = "", password = "";
        if (!_alreadyAuthed) {
            email    = document.getElementById("f-email").value.trim();
            password = document.getElementById("f-password").value;
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) return alert("err", "Enter a valid email.");
            if (!/^(?=.*[A-Za-z])(?=.*\d).{8,}$/.test(password)) {
                return alert("err", "Password must be at least 8 characters with a letter and a digit.");
            }
        }

        const body = {
            type:           _type,
            name,
            mobile,
            email:          email || undefined,
            password:       password || undefined,
            qualification:  document.getElementById("f-qual")?.value.trim(),
            specialization: document.getElementById("f-spec")?.value.trim(),
            clinicName:     document.getElementById("f-clinic")?.value.trim(),
            ownerName:      document.getElementById("f-owner")?.value.trim(),
            speciality:     document.getElementById("f-speciality")?.value.trim(),
            address:        document.getElementById("f-address").value.trim(),
            timings:        document.getElementById("f-timings").value.trim(),
            licenceNo:      document.getElementById("f-licence").value.trim(),
        };

        try {
            if (_alreadyAuthed) {
                // Existing user path — attach application to current account.
                const r = await AFP.POST("/api/business/apply", body);
                _appId = r.id;
            } else {
                // Public signup path — creates the citizen user + draft
                // application atomically and returns tokens so the applicant
                // is logged in for the upload-doc + mark-paid calls.
                const r = await AFP.POST("/api/business/register", body);
                AFP.login(r.user, r.token, r.refreshToken, false);
                _appId = r.application.id;
            }
            gotoStep(2);
        } catch (ex) { alert("err", "Save failed: " + ex.message); }
    };

    // ── Step 2 → upload doc, then skip payment (temporarily disabled) ───
    window.uploadDoc = async function () {
        const file = document.getElementById("f-doc").files[0];
        if (!file) return alert("err", "Please choose a file to upload.");
        if (file.size > 10 * 1024 * 1024) return alert("err", "File too large (max 10 MB).");
        try {
            await AFP.uploadFile(`/api/business/${_appId}/upload-doc`, file, "doc");
            // Payment step is disabled — go straight to the payment screen so
            // the applicant sees the "no fee" notice, then submits.
            gotoStep(3);
        } catch (ex) { alert("err", "Upload failed: " + ex.message); }
    };

    // ── Step 3 → skip payment (mirrors pet-registration "no payment" flow) ─
    // We still call mark-paid with a synthetic id so the super-admin queue
    // treats the row as ready-for-review (state = 'paid'). This means when
    // real payments are re-enabled we only need to swap this function's body
    // back to the original Razorpay flow (kept in git history) — no schema
    // change required.
    window.skipPayment = async function () {
        try {
            const syntheticId = `NOPAY_${Date.now()}`;
            await AFP.POST(`/api/business/${_appId}/mark-paid`, {
                payment_id: syntheticId,
                order_id:   syntheticId,
            });
            // A vet / shop applicant is NOT a pet owner. If we auto-signed
            // them up in step 1 (public path), clear the just-issued citizen
            // session locally so the "Back to home" link on step 4 lands
            // them on the splash screen — not the pet-owner dashboard.
            // Their listing is pending Super Admin review; they can log
            // back in later once approved.
            if (!_alreadyAuthed) {
                ["afp_token", "afp_refresh", "afp_user"].forEach(k => {
                    try { localStorage.removeItem(k);   } catch { }
                    try { sessionStorage.removeItem(k); } catch { }
                });
            }
            gotoStep(4);
        } catch (ex) { alert("err", "Submit failed: " + ex.message); }
    };

    // Boot
    loadFee();
})();
</script>
</body>
</html>
