@page
@model IndexModel
@{
    Layout = "_AppLayout";
}

@* ─────────────────────────────────────────────────────────────────────────────
   The citizen + admin SPA-ish shell. Each screen is a fixed-position <div>
   toggled by AFP.go(...) in wwwroot/js/afp-core.js. To keep this file focused
   on the app skeleton, the screens are split into partials by area of concern.
   ────────────────────────────────────────────────────────────────────────────*@

<div class="afp-app">

    @* Splash + citizen/admin login + citizen registration *@
    <partial name="Partials/_Auth" />

    @* Dashboard, profile, pet profile, pet CRUD (new/renew/transfer/report) *@
    <partial name="Partials/_CitizenMain" />

    @* Search, notifications, adoption, vaccines, vets/shops, forum, census, etc. *@
    <partial name="Partials/_CitizenServices" />

    @* Municipal admin portal shell (tabs + body rendered by afp-admin.js) *@
    <partial name="Partials/_Admin" />

    @* All bottom-sheet / centred modals + global toast *@
    <partial name="Partials/_Modals" />

</div>

@section Scripts {
<script>
    // Augment AFP.go: screen lifecycle hooks
    const _origGo = AFP.go;
    const _patchedGo = function(screen) {
        if (screen === 'petProfile') {
            // petProfile manages its own DOM visibility inside loadPetProfile()
            loadPetProfile();
            return;
        }
        _origGo(screen);
        if (screen === 'newPet')        { setTimeout(initNewPet,        50); }
        if (screen === 'reportPet')     { setTimeout(initReportPet,     50); }
        if (screen === 'renew')         { setTimeout(initRenew,         50); }
        if (screen === 'newOwner')      { setTimeout(initNewOwner,      50); }
        if (screen === 'forum')         { setTimeout(() => Forum.loadForum(), 50); }
        if (screen === 'searchDoctor')  { setTimeout(loadSearchDoctor,  50); }
        if (screen === 'searchShop')    { setTimeout(loadSearchShop,    50); }
        if (screen === 'breedingMatch') { setTimeout(loadBreedingMatch, 50); }
    };
    Object.defineProperty(AFP, 'go', { get: () => _patchedGo });
</script>
}
