@page
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Municipal Pet Registry for Modern Cities";
    ViewData["Description"] = "Register, license and manage every pet in your city — from citizen phone to ward officer's desk. Digital certificates, QR tags, per-nigam fees, and audit-ready records.";
}

@section Head {
    <style>
        /* ── Hero ── */
        .hero{background:linear-gradient(180deg,#FFF3E8 0%,#FFFFFF 100%);padding:72px 0 60px;}
        .hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:56px;align-items:center;max-width:1140px;margin:0 auto;padding:0 22px;}
        .hero-visual{background:#1A1814;border-radius:22px;padding:38px 28px;color:#fff;text-align:center;position:relative;overflow:hidden;}
        .hero-visual::before{content:'';position:absolute;inset:-2px;border-radius:22px;background:linear-gradient(135deg,rgba(232,103,10,.35),transparent 55%);pointer-events:none;}
        .hero-visual-card{background:#fff;color:#1A1814;border-radius:14px;padding:20px;text-align:left;margin-top:22px;box-shadow:0 20px 46px rgba(0,0,0,.35);position:relative;z-index:1;}
        .hero-badge{display:inline-block;background:rgba(232,103,10,.2);color:#F5D87A;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:999px;font-weight:700;margin-bottom:14px;}
        .hero-pet-emoji{font-size:60px;position:relative;z-index:1;}
        .hero-license-title{font-weight:800;font-size:15px;margin-bottom:2px;}
        .hero-license-id{font-family:monospace;color:#E8670A;font-weight:700;font-size:12px;margin-bottom:14px;}
        .hero-license-row{display:flex;justify-content:space-between;font-size:12px;padding:5px 0;border-bottom:1px dashed #E5E0D8;}
        .hero-license-row:last-of-type{border-bottom:none;}
        .hero-license-row span:first-child{color:#9A958C;}
        .hero-license-row span:last-child{font-weight:600;}
        .hero-license-chip{display:inline-block;background:#D1FAE5;color:#065F46;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;margin-top:10px;}
        @@media (max-width:820px){
            .hero-grid{grid-template-columns:1fr;gap:40px;}
        }

        /* ── Trust bar ── */
        .trust{background:#F7F5F2;padding:26px 0;border-top:1px solid #E5E0D8;border-bottom:1px solid #E5E0D8;}
        .trust-inner{max-width:1140px;margin:0 auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;}
        .trust-label{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;color:#9A958C;font-weight:700;}
        .trust-logos{display:flex;gap:32px;flex-wrap:wrap;align-items:center;color:#5A564F;font-weight:600;font-size:14px;}

        /* ── Feature grid ── */
        .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:38px;}
        .feat-card{background:#fff;border:1px solid #E5E0D8;border-radius:14px;padding:26px 22px;transition:transform .15s ease, box-shadow .15s ease;}
        .feat-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.06);}
        .feat-icon{width:44px;height:44px;border-radius:12px;background:#FFF3E8;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:14px;}
        .feat-card p{color:#5A564F;font-size:14px;line-height:1.6;}
        @@media (max-width:820px){ .feat-grid{grid-template-columns:1fr 1fr;} }
        @@media (max-width:520px){ .feat-grid{grid-template-columns:1fr;} }

        /* ── How it works ── */
        .how{background:#F7F5F2;}
        .how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:38px;position:relative;}
        .how-step{background:#fff;border-radius:14px;padding:24px 20px;text-align:center;border:1px solid #E5E0D8;}
        .how-num{width:38px;height:38px;border-radius:50%;background:#E8670A;color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;}
        .how-step p{color:#5A564F;font-size:13.5px;}
        @@media (max-width:820px){ .how-grid{grid-template-columns:1fr 1fr;} }
        @@media (max-width:520px){ .how-grid{grid-template-columns:1fr;} }

        /* ── Split section ── */
        .split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;}
        .split-visual{background:#1A1814;border-radius:18px;padding:34px 28px;color:#fff;}
        .split-visual .label{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#F5D87A;font-weight:700;margin-bottom:8px;}
        .split-metric{background:#2D2820;border-radius:12px;padding:16px 18px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
        .split-metric-lbl{font-size:12px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.6px;}
        .split-metric-val{font-size:22px;font-weight:800;color:#fff;}
        .split-metric-val small{color:#F5D87A;font-size:12px;font-weight:600;margin-left:4px;}
        @@media (max-width:820px){ .split{grid-template-columns:1fr;} }

        /* ── Testimonial ── */
        .quote{background:#1A1814;color:#fff;border-radius:22px;padding:44px 44px;text-align:center;position:relative;overflow:hidden;}
        .quote::before{content:"\201C";position:absolute;top:-30px;left:24px;font-size:180px;color:rgba(232,103,10,.25);font-family:Georgia,serif;line-height:1;}
        .quote-txt{font-size:22px;line-height:1.5;font-weight:500;max-width:780px;margin:0 auto 20px;position:relative;z-index:1;}
        .quote-attr{font-size:14px;color:#F5D87A;font-weight:700;}
        .quote-attr-role{color:rgba(255,255,255,.6);font-weight:400;font-size:12px;margin-top:2px;}

        /* ── Final CTA ── */
        .final-cta{background:linear-gradient(135deg,#E8670A 0%,#C25500 100%);border-radius:22px;padding:56px 32px;color:#fff;text-align:center;}
        .final-cta h2{font-size:32px;font-weight:800;margin-bottom:10px;color:#fff;}
        .final-cta p{color:rgba(255,255,255,.9);margin-bottom:24px;max-width:560px;margin-left:auto;margin-right:auto;font-size:16px;}
        .final-cta .mk-btn-outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.4);}
        .final-cta .mk-btn-outline:hover{background:rgba(255,255,255,.1);border-color:#fff;color:#fff;}
        .final-cta .mk-btn-primary{background:#fff;color:#C25500;}
        .final-cta .mk-btn-primary:hover{background:#F5D87A;color:#1A1814;}
    </style>
}

<!-- ═════════════════ HERO ═════════════════ -->
<section class="hero">
    <div class="hero-grid">
        <div>
            <span class="mk-pill">&#x1F3DB;&#xFE0F; Municipal-grade pet registry</span>
            <h1 class="mk-h1">Every pet in your city, licensed &amp; loved.</h1>
            <p class="mk-lead">
                All For Pets connects citizens to their Nigam's licensing office in one tap.
                Digital certificates, QR tags, per-nigam fees, and audit-ready records &mdash;
                no more paper trails.
            </p>
            <div class="mk-btn-row">
                <a class="mk-btn mk-btn-primary" href="/">Register your pet &rarr;</a>
                <a class="mk-btn mk-btn-outline" href="/Marketing#how-it-works">See how it works</a>
            </div>
            <div style="margin-top:22px;font-size:13px;color:#9A958C">
                &#x2705; No credit card required &nbsp;&middot;&nbsp; &#x2705; Free to try &nbsp;&middot;&nbsp; &#x2705; Live in minutes
            </div>
        </div>
        <div class="hero-visual">
            <span class="hero-badge">&#x1F4DC; Licence Preview</span>
            <div class="hero-pet-emoji">&#x1F415;</div>
            <div class="hero-visual-card">
                <div class="hero-license-title">Bruno the Labrador</div>
                <div class="hero-license-id">AFP-JA-0142</div>
                <div class="hero-license-row"><span>Species</span><span>Dog &middot; Labrador</span></div>
                <div class="hero-license-row"><span>Owner</span><span>Priya Sharma</span></div>
                <div class="hero-license-row"><span>Ward</span><span>Ward 12, Jaipur</span></div>
                <div class="hero-license-row"><span>Valid until</span><span>18 Sep 2027</span></div>
                <div class="hero-license-chip">&#x2705; Active Licence</div>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════ TRUST BAR ═════════════════ -->
<section class="trust">
    <div class="trust-inner">
        <span class="trust-label">Built for municipal corporations across India</span>
        <div class="trust-logos">
            <span>&#x1F3D9;&#xFE0F; Jaipur</span>
            <span>&#x1F3D9;&#xFE0F; Delhi</span>
            <span>&#x1F3D9;&#xFE0F; Mumbai</span>
            <span>+ your city next</span>
        </div>
    </div>
</section>

<!-- ═════════════════ FEATURES ═════════════════ -->
<section class="mk-section" id="features">
    <div class="mk-container mk-center">
        <span class="mk-pill">Features</span>
        <h2 class="mk-h2">Everything a modern Nigam needs</h2>
        <p class="mk-lead">
            One platform for citizens and staff, with role-based dashboards for every level
            &mdash; Ward, Zone, Nigam, City, and Super Admin.
        </p>
    </div>

    <div class="mk-container">
        <div class="feat-grid">
            <div class="feat-card">
                <div class="feat-icon">&#x1F415;</div>
                <h3 class="mk-h3">Pet registration</h3>
                <p>Citizens register in minutes with photo and vaccine certificate uploads. Ward officers review and approve from a mobile-friendly queue.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F4DC;</div>
                <h3 class="mk-h3">Digital certificates</h3>
                <p>Every approved pet gets a print-ready licence PDF with a unique Pet ID and scannable QR code &mdash; no manual paperwork.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F4B0;</div>
                <h3 class="mk-h3">Per-Nigam pricing</h3>
                <p>Each Nigam sets its own Registration, Renewal, and Transfer fees. Every change is audit-logged with old &rarr; new value, who, and when.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F489;</div>
                <h3 class="mk-h3">Vaccine tracking</h3>
                <p>Vaccine due-date reminders, certificate uploads, and a health journal per pet. Overdue alerts on the citizen's dashboard.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F4CD;</div>
                <h3 class="mk-h3">Vets &amp; shops directory</h3>
                <p>A searchable list of verified vets and pet shops in each city, with geo-filtering, timings, and one-tap calling.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F4CA;</div>
                <h3 class="mk-h3">Analytics &amp; billing</h3>
                <p>Live pet census, revenue by Ward/Nigam/City, and audit logs. Super Admin sees everything; every other role stays neatly scoped.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F49E;</div>
                <h3 class="mk-h3">Breeding directory</h3>
                <p>Opt-in matchmaking for responsible breeding, with owner consent and in-app introductions. Never a public phone number.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F6A8;</div>
                <h3 class="mk-h3">Stray &amp; cruelty reports</h3>
                <p>Citizens raise reports geo-tagged to their ward. Staff comment, resolve and log every action in an audit trail.</p>
            </div>
            <div class="feat-card">
                <div class="feat-icon">&#x1F4F1;</div>
                <h3 class="mk-h3">Mobile app included</h3>
                <p>Android app with App Links &mdash; QR scans open pet profiles directly. Web works everywhere, no install required.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════ HOW IT WORKS ═════════════════ -->
<section class="mk-section how" id="how-it-works">
    <div class="mk-container mk-center">
        <span class="mk-pill">How it works</span>
        <h2 class="mk-h2">Live in four simple steps</h2>
        <p class="mk-lead">
            From onboarding your city geography to citizens carrying their pet's QR tag &mdash; here's the shortest path to a licensed city.
        </p>
    </div>
    <div class="mk-container">
        <div class="how-grid">
            <div class="how-step">
                <div class="how-num">1</div>
                <h3 class="mk-h3">Onboard your city</h3>
                <p>We seed your Cities, Nigams, Zones and Wards. Set your initial fees per Nigam.</p>
            </div>
            <div class="how-step">
                <div class="how-num">2</div>
                <h3 class="mk-h3">Add your staff</h3>
                <p>Create Ward, Zone, Nigam and City admins. Each role sees only what they should.</p>
            </div>
            <div class="how-step">
                <div class="how-num">3</div>
                <h3 class="mk-h3">Citizens register</h3>
                <p>They sign up, add pets, and submit for approval &mdash; from web or mobile app.</p>
            </div>
            <div class="how-step">
                <div class="how-num">4</div>
                <h3 class="mk-h3">Approve &amp; issue</h3>
                <p>Ward officers approve. Pet ID, QR, and PDF licence are generated automatically.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════ SPLIT: ADMIN DASHBOARD ═════════════════ -->
<section class="mk-section">
    <div class="mk-container">
        <div class="split">
            <div>
                <span class="mk-pill">For Municipal Staff</span>
                <h2 class="mk-h2">A dashboard for every role.</h2>
                <p class="mk-lead">
                    Ward officers see their ward. Nigam managers see their Nigam. Super Admins see everything.
                    Everyone gets pending queues, analytics, and audit trails scoped to their scope.
                </p>
                <ul style="list-style:none;padding:0;margin:0;color:#5A564F;font-size:15px">
                    <li style="padding:6px 0">&#x2705; Bulk-approve pending pets in one click</li>
                    <li style="padding:6px 0">&#x2705; Comment threads on stray/cruelty reports</li>
                    <li style="padding:6px 0">&#x2705; Fees editable per Nigam with full history</li>
                    <li style="padding:6px 0">&#x2705; Manage users up to the roles you're allowed</li>
                    <li style="padding:6px 0">&#x2705; Daily automated backups (Super Admin)</li>
                </ul>
            </div>
            <div class="split-visual">
                <div class="label">Live from Jaipur Nagar Nigam</div>
                <div style="font-size:20px;font-weight:800;margin-bottom:16px">This month at a glance</div>
                <div class="split-metric">
                    <div>
                        <div class="split-metric-lbl">Total pets</div>
                        <div class="split-metric-val">6 <small>&uparrow; 33%</small></div>
                    </div>
                </div>
                <div class="split-metric">
                    <div>
                        <div class="split-metric-lbl">Approved licences</div>
                        <div class="split-metric-val">4</div>
                    </div>
                </div>
                <div class="split-metric">
                    <div>
                        <div class="split-metric-lbl">Est. revenue</div>
                        <div class="split-metric-val">&#x20B9; 850</div>
                    </div>
                </div>
                <div class="split-metric">
                    <div>
                        <div class="split-metric-lbl">Pending review</div>
                        <div class="split-metric-val">1</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════ TESTIMONIAL ═════════════════ -->
<section class="mk-section-tight">
    <div class="mk-container">
        <div class="quote">
            <div class="quote-txt">
                All For Pets replaced our spreadsheets and paper counters overnight.
                Ward officers now approve pets from their phones and citizens carry a QR-tagged licence
                the same day.
            </div>
            <div class="quote-attr">Municipal Health Officer</div>
            <div class="quote-attr-role">Pilot Nigam &middot; Rajasthan</div>
        </div>
    </div>
</section>

<!-- ═════════════════ FINAL CTA ═════════════════ -->
<section class="mk-section" id="contact">
    <div class="mk-container">
        <div class="final-cta">
            <h2>Ready to license every pet in your city?</h2>
            <p>Try the citizen app today or book a demo for your municipal team &mdash; we'll seed your city in under an hour.</p>
            <div class="mk-btn-row" style="justify-content:center">
                <a class="mk-btn mk-btn-primary" href="/">Try it free &rarr;</a>
                <a class="mk-btn mk-btn-outline" href="/Pricing">See pricing</a>
            </div>
        </div>
    </div>
</section>
