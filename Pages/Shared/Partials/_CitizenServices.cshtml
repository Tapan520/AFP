<!-- --- SCREEN: BREEDING MATCH ------------------------------------------ -->
<div id="screen-breedingMatch" class="afp-screen screen d-none">
    <div class="topbar">
        <div class="topbar-left">
            <button class="back-btn" onclick="AFP.go('dashboard')">&#x2190;</button>
            <span class="topbar-title">&#x1F49E; Breeding Match</span>
        </div>
        <button class="icon-btn" title="Logout" onclick="AFP.logout()">&#x1F6AA;</button>
    </div>
    <div style="padding:13px;background:#fff;border-bottom:1px solid var(--bd)">
        <div class="chips">
            <button class="chip breeding-species-chip active" data-sp=""
                onclick="setBreedingSpecies(this,'')">All</button>
            <button class="chip breeding-species-chip" data-sp="dog"
                onclick="setBreedingSpecies(this,'dog')">&#x1F436; Dogs</button>
            <button class="chip breeding-species-chip" data-sp="cat"
                onclick="setBreedingSpecies(this,'cat')">&#x1F431; Cats</button>
            <button class="chip breeding-species-chip" data-sp="rabbit"
                onclick="setBreedingSpecies(this,'rabbit')">&#x1F430; Rabbits</button>
            <button class="chip breeding-species-chip" data-sp="bird"
                onclick="setBreedingSpecies(this,'bird')">&#x1F426; Birds</button>
        </div>
        <div class="d-row" style="gap:8px;margin-top:10px">
            <input id="breeding-breed-q" class="field-input"
                style="flex:2;font-size:13px"
                placeholder="Breed (e.g. Labrador)"
                oninput="doBreedingSearch()" />
            <select id="breeding-gender" class="field-input"
                style="flex:1;font-size:13px"
                onchange="doBreedingSearch()">
                <option value="">Any gender</option>
                <option value="male">&#x2642; Male</option>
                <option value="female">&#x2640; Female</option>
            </select>
        </div>
    </div>
    <div id="breeding-results" class="scroll" style="padding:13px"></div>
</div>

