@* All bottom-sheet / centred modal dialogs used across the app + the global toast. *@

<!-- --- FORUM: NEW / EDIT THREAD MODAL ---------------------------------- -->
<div id="forum-thread-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div id="forum-thread-modal-title" style="font-size:16px;font-weight:700"></div>
            <button style="background:none;border:none;font-size:20px;color:var(--tx3);cursor:pointer;line-height:1"
                onclick="Forum.closeThreadModal()">&times;</button>
        </div>
        <div id="forum-thread-modal-err" style="margin-bottom:4px"></div>
        <div id="forum-thread-modal-body"
             class="scroll" style="max-height:65vh;overflow-y:auto;padding-right:4px"></div>
        <div class="d-row" style="margin-top:16px">
            <button class="btn btn-ghost" onclick="Forum.closeThreadModal()">Cancel</button>
            <button id="forum-thread-modal-save-btn" class="btn btn-primary"
                onclick="Forum.saveThread()">
                &#x2714;&#xFE0F; Post Discussion
            </button>
        </div>
    </div>
</div>

<!-- --- FORUM: CONFIRM DELETE MODAL -------------------------------------- -->
<div id="forum-confirm-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet" style="text-align:center">
        <div class="modal-handle"></div>
        <div style="font-size:36px;margin-bottom:10px">&#x1F5D1;&#xFE0F;</div>
        <div style="font-size:16px;font-weight:700;margin-bottom:8px">Confirm Delete</div>
        <div id="forum-confirm-msg"
             style="font-size:14px;color:var(--tx2);margin-bottom:20px;line-height:20px"></div>
        <div class="d-row">
            <button class="btn btn-ghost" onclick="Forum.closeConfirmModal()">Cancel</button>
            <button id="forum-confirm-del-btn" class="btn btn-danger"
                onclick="Forum.executeConfirm()">
                &#x1F5D1;&#xFE0F; Delete
            </button>
        </div>
    </div>
</div>

<!-- --- GLOBAL TOAST -------------------------------------------------- -->
<div id="afp-toast" class="afp-toast hidden"></div>

<!-- --- ADOPTION INTEREST MODAL -------------------------------------- -->
<div id="adoption-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div id="adoption-modal-name" style="font-size:16px;font-weight:700"></div>
            <button style="background:none;border:none;font-size:20px;color:var(--tx3);cursor:pointer"
                onclick="closeAdoptionModal()">&times;</button>
        </div>
        <div class="card"><div id="adoption-modal-details"></div></div>
        <div style="background:var(--ok-p);border-radius:10px;padding:11px 13px;margin-top:12px;
                    font-size:12px;color:#065F46;line-height:18px">
            &#x2139;&#xFE0F; Your contact info will be shared with the pet owner to arrange a meeting.
        </div>
        <div class="d-row mt-8">
            <button id="adoption-interest-btn" class="btn btn-primary">&#x1F43E; Send Interest</button>
            <button class="btn btn-ghost" onclick="closeAdoptionModal()">Cancel</button>
        </div>
    </div>
</div>

<!-- --- ADD EVENT MODAL ----------------------------------------------- -->
<div id="event-add-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="font-size:16px;font-weight:700">&#x1F4C5; New Event</div>
            <button style="background:none;border:none;font-size:20px;color:var(--tx3);cursor:pointer"
                onclick="closeAddEventModal()">&times;</button>
        </div>
        <div class="field">
            <label class="field-label">Event Type</label>
            <select id="ev-type" class="field-input">
                <option value="vaccination">&#x1F489; Vaccination Camp</option>
                <option value="adoption">&#x1F43E; Adoption Drive</option>
                <option value="meetup">&#x1F415; Meetup</option>
                <option value="awareness">&#x1F4E2; Awareness Camp</option>
            </select>
        </div>
        <div class="field"><label class="field-label">Title *</label>
            <input id="ev-title" class="field-input" placeholder="Event title" /></div>
        <div class="field"><label class="field-label">Date *</label>
            <input id="ev-date" class="field-input" type="date" /></div>
        <div class="field"><label class="field-label">Location *</label>
            <input id="ev-location" class="field-input" placeholder="Venue / address" /></div>
        <div class="field"><label class="field-label">Description</label>
            <textarea id="ev-desc" class="field-input" rows="3"
                placeholder="Describe the event..."></textarea></div>
        <div class="d-row mt-8">
            <button class="btn btn-ghost" onclick="closeAddEventModal()">Cancel</button>
            <button class="btn btn-primary" onclick="saveNewEvent()">&#x2714;&#xFE0F; Create Event</button>
        </div>
    </div>
</div>

<!-- --- QR CODE MODAL ------------------------------------------------- -->
<div id="qr-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet" style="text-align:center">
        <div class="modal-handle"></div>
        <div style="font-size:17px;font-weight:700;margin-bottom:3px">&#x1F4F1; Pet QR Code</div>
        <div style="font-size:12px;color:var(--tx2);margin-bottom:18px">Scan to identify your pet</div>
        <div class="qr-wrap"><div id="qr-grid"></div></div>
        <div id="qr-pet-id" style="font-size:11px;font-family:monospace;color:var(--tx3);margin-bottom:2px"></div>
        <div id="qr-pet-name" style="font-size:14px;font-weight:700;margin-bottom:1px"></div>
        <div id="qr-pet-sub" style="font-size:12px;color:var(--tx2);margin-bottom:16px"></div>
        <div style="background:var(--sf2);border-radius:10px;padding:12px;margin-bottom:16px;text-align:left">
            <div id="qr-details"></div>
        </div>
        <div class="gap-8">
            <button class="btn btn-primary" onclick="AFP.tst('&#x1F4F1; Sharing QR…');closeQRModal()">&#x1F4F1; Share QR Code</button>
            <button class="btn btn-ghost" onclick="closeQRModal()">Close</button>
        </div>
    </div>
</div>

