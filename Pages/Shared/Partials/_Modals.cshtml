                &#x1F511; Reset Password
            </button>
        </div>
    </div>
</div>

<!-- --- PAYMENT MODAL ------------------------------------------------ -->
<div id="pay-modal" class="modal-bg" style="display:none">
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div style="display:flex;align-items:center;gap:11px;margin-bottom:18px">
            <div style="width:46px;height:46px;border-radius:13px;background:var(--ok-p);
                        display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">
                &#x1F4B3;
            </div>
            <div>
                <div style="font-size:16px;font-weight:700">Secure Payment</div>
                <div style="font-size:12px;color:var(--tx2)">Powered by Razorpay</div>
            </div>
        </div>
        <div class="pay-summary-card">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <div>
                    <div id="pay-purpose-label" style="font-size:13px;font-weight:600"></div>
                    <div id="pay-pet-name" style="font-size:12px;color:var(--tx2);margin-top:2px"></div>
                </div>
                <div id="pay-amount" style="font-size:24px;font-weight:700;color:var(--or)"></div>
            </div>
        </div>
        <div style="font-size:11px;font-weight:600;color:var(--tx2);text-transform:uppercase;
                    letter-spacing:.5px;margin-bottom:8px">Pay via</div>
        <div class="chips" style="margin-bottom:16px">
            <button class="chip pay-method-chip active" data-method="upi">&#x1F4F1; UPI</button>
            <button class="chip pay-method-chip" data-method="card">&#x1F4B3; Card</button>
            <button class="chip pay-method-chip" data-method="netbanking">&#x1F3E6; Net Banking</button>
            <button class="chip pay-method-chip" data-method="wallet">&#x1F4B0; Wallet</button>
        </div>
        <div class="pay-benefits">
            <div class="pay-benefit-row">&#x2705; Official municipal pet licence</div>
            <div class="pay-benefit-row">&#x2705; 1-year validity certificate (PDF)</div>
            <div class="pay-benefit-row">&#x2705; Unique Pet ID &amp; QR code</div>
            <div class="pay-benefit-row">&#x1F512; 256-bit encrypted &amp; secure</div>
        </div>
        <div id="pay-err" style="margin-bottom:4px"></div>
        <div id="pay-processing"
             style="display:none;align-items:center;gap:9px;padding:11px;
                    background:var(--ok-p);border-radius:8px;margin-bottom:12px">
            <span class="spinner mini-spinner"></span>
            <span style="font-size:13px;color:#065F46;font-weight:600">Verifying payment… please wait</span>
        </div>
        <button id="pay-btn" class="btn btn-primary" onclick="Payment.startPayment()">
            &#x1F512; Pay Now
        </button>
        <button class="btn btn-ghost mt-8" onclick="Payment.closePaymentModal()">Cancel</button>
        <div style="text-align:center;font-size:11px;color:var(--tx3);margin-top:12px">
            &#x1F512; Payments processed securely by Razorpay. We never store card details.
        </div>
    </div>
</div>

