        <button class="icon-btn" title="Logout" onclick="AFP.logout()">&#x1F6AA;</button>
    </div>
    <div id="shophome-body" class="scroll" style="padding-bottom:70px"></div>
    <div class="bnav">
        <div class="bnav-item active" onclick="AFP.go('shopHome')"><span class="bnav-icon">&#x1F3E0;</span><span class="bnav-lbl">Home</span></div>
        <div class="bnav-item" onclick="AFP.go('appStatus')"><span class="bnav-icon">&#x1F6D2;</span><span class="bnav-lbl">Listing</span></div>
        <div class="bnav-item" onclick="AFP.logout()"><span class="bnav-icon">&#x1F6AA;</span><span class="bnav-lbl">Logout</span></div>
    </div>
</div>

