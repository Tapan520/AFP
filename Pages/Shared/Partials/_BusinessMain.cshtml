@* Business (Vet / Shop) landing screens for users whose citizen account is
   linked to a business_applications row. See wwwroot/js/afp-business.js for
   the loader logic and post-login routing. *@

<!-- --- SCREEN: APPLICATION STATUS --------------------------------------- -->
<div id="screen-appStatus" class="afp-screen screen d-none">
    <div class="topbar">
        <div class="topbar-left">
            <button class="back-btn" onclick="appStatusBack()">&#x2190;</button>
            <span class="topbar-title">Your Application</span>
        </div>
        <button class="icon-btn" title="Logout" onclick="AFP.logout()">&#x1F6AA;</button>
    </div>
    <div id="appstatus-body" class="scroll p-18 pb-32"></div>
</div>

<!-- --- SCREEN: VET / DOCTOR HOME --------------------------------------- -->
<div id="screen-vetHome" class="afp-screen screen d-none">
    <div class="topbar">
        <div class="topbar-left">
            <div class="topbar-logo">&#x1FA7A;</div>
            <span class="topbar-title">Vet Portal</span>
        </div>
        <button class="icon-btn" title="Logout" onclick="AFP.logout()">&#x1F6AA;</button>
    </div>
    <div id="vethome-body" class="scroll" style="padding-bottom:70px"></div>
    <div class="bnav">
        <div class="bnav-item active" onclick="AFP.go('vetHome')"><span class="bnav-icon">&#x1F3E0;</span><span class="bnav-lbl">Home</span></div>
        <div class="bnav-item" onclick="AFP.go('appStatus')"><span class="bnav-icon">&#x1FA7A;</span><span class="bnav-lbl">Listing</span></div>
        <div class="bnav-item" onclick="AFP.logout()"><span class="bnav-icon">&#x1F6AA;</span><span class="bnav-lbl">Logout</span></div>
    </div>
</div>

<!-- --- SCREEN: SHOP OWNER HOME ----------------------------------------- -->
