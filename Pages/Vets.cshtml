@page "/vets/{city?}"
@model AFP.Pages.VetsModel
@{
    Layout = null;
    var title     = string.IsNullOrEmpty(Model.CitySlug)
        ? "Veterinary Doctors in India | All For Pets"
        : $"Veterinary Doctors in {Model.CityName} | All For Pets";
    var descr     = string.IsNullOrEmpty(Model.CitySlug)
        ? "Find verified veterinary doctors across India. All For Pets — the official municipal pet registry."
        : $"Find {Model.Doctors.Count} verified veterinary doctors in {Model.CityName}. Clinic address, timings, contact, specialization — All For Pets municipal registry.";
    var canonical = $"{Request.Scheme}://{Request.Host}{Request.Path}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@descr" />
    <link rel="canonical" href="@canonical" />
    <meta name="robots" content="index,follow" />

    <meta property="og:type"        content="website" />
    <meta property="og:title"       content="@title" />
    <meta property="og:description" content="@descr" />
    <meta property="og:url"         content="@canonical" />
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content="@title" />
    <meta name="twitter:description" content="@descr" />

    @* JSON-LD: ItemList of LocalBusiness (VeterinaryCare) so Google can render
       rich cards for local search. *@
    @if (Model.Doctors.Any())
    {
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "itemListElement": [
            @Html.Raw(string.Join(",\n            ", Model.Doctors.Select((d, i) => $@"{{
              ""@@type"": ""ListItem"",
              ""position"": {i + 1},
              ""item"": {{
                ""@@type"": ""VeterinaryCare"",
                ""name"": {System.Text.Json.JsonSerializer.Serialize(d.ClinicName ?? d.Name ?? "")},
                ""description"": {System.Text.Json.JsonSerializer.Serialize(d.Specialization ?? "")},
                ""telephone"": {System.Text.Json.JsonSerializer.Serialize(d.Mobile ?? "")},
                ""address"": {System.Text.Json.JsonSerializer.Serialize(d.Address ?? "")},
                ""areaServed"": {System.Text.Json.JsonSerializer.Serialize(d.CityName ?? Model.CityName)}
              }}
            }}")))
          ]
        }
        </script>
    }

    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin:0; background:#F7F5F2; color:#1A1814; }
        .wrap { max-width: 720px; margin: 0 auto; padding: 24px 18px; }
        h1 { font-size:24px; margin:0 0 6px; }
        .sub { color:#5A564F; font-size:14px; margin-bottom:20px; }
        .card { background:#fff; border-radius:14px; box-shadow:0 2px 8px rgba(0,0,0,.05); padding:16px 18px; margin-bottom:12px; }
        .name { font-size:16px; font-weight:700; }
        .qual { color:#5A564F; font-size:12px; margin-top:2px; }
        .row { margin-top:8px; font-size:13px; color:#3A3630; line-height:20px; }
        .row strong { color:#1A1814; }
        .badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; background:#DBEAFE; color:#1E40AF; margin-left:6px; }
        .b24 { background:#FEE2E2; color:#991B1B; }
        a.cta { display:inline-block; margin-top:6px; padding:8px 14px; background:#E8670A; color:#fff; border-radius:8px; text-decoration:none; font-weight:600; font-size:13px; }
        .empty { text-align:center; color:#5A564F; padding:32px 12px; }
        .brand { text-align:center; color:#9A958C; font-size:11px; margin-top:24px; }
    </style>
</head>
<body>
    <div class="wrap">
        <h1>Veterinary Doctors in @Model.CityName</h1>
        <div class="sub">
            @if (Model.Doctors.Any())
            {
                @($"{Model.Doctors.Count} verified veterinarians registered with the All For Pets Municipal Portal.")
            }
            else
            {
                @($"No veterinarians listed for {Model.CityName} yet — check back soon.")
            }
        </div>

        @if (!Model.Doctors.Any())
        {
            <div class="card empty">
                <p>No veterinary doctors found for <strong>@Model.CityName</strong>.</p>
                <a class="cta" href="/">Explore All For Pets →</a>
            </div>
        }
        else
        {
            foreach (var d in Model.Doctors)
            {
                <div class="card">
                    <div class="name">
                        @(d.ClinicName ?? d.Name)
                        @if (d.Is24hr) { <span class="badge b24">24/7</span> }
                    </div>
                    <div class="qual">Dr. @d.Name @(!string.IsNullOrWhiteSpace(d.Qualification) ? "· " + d.Qualification : "")</div>
                    @if (!string.IsNullOrWhiteSpace(d.Specialization))
                    { <div class="row"><strong>Specialization:</strong> @d.Specialization</div> }
                    @if (!string.IsNullOrWhiteSpace(d.Address))
                    { <div class="row"><strong>📍</strong> @d.Address, @d.CityName</div> }
                    @if (!string.IsNullOrWhiteSpace(d.Timings))
                    { <div class="row"><strong>🕒</strong> @d.Timings</div> }
                    @if (!string.IsNullOrWhiteSpace(d.Mobile))
                    { <div class="row"><strong>📞</strong> <a href="tel:@d.Mobile">@d.Mobile</a></div> }
                </div>
            }
            <a class="cta" href="/">Register your pet on All For Pets →</a>
        }

        <div class="brand">🐾 All For Pets — Municipal Pet Registry</div>
    </div>
</body>
</html>
