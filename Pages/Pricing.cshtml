@page
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Pricing";
    ViewData["Description"] = "Transparent, per-city pricing for the All For Pets Municipal Registry. Free tier for pilots, scalable plans for full deployments.";
}

@section Head {
    <style>
        /* ── Hero ── */
        .pr-hero{background:linear-gradient(180deg,#FFF3E8 0%,#FFFFFF 100%);padding:64px 0 20px;text-align:center;}

        /* ── Toggle ── */
        .pr-toggle{display:inline-flex;background:#F7F5F2;border:1px solid #E5E0D8;border-radius:999px;padding:4px;margin:22px auto 0;}
        .pr-toggle button{padding:8px 18px;border-radius:999px;font-weight:600;font-size:13px;color:#5A564F;border:none;background:transparent;transition:all .15s;}
        .pr-toggle button.active{background:#fff;color:#1A1814;box-shadow:0 1px 3px rgba(0,0,0,.08);}

        /* ── Plans ── */
        .plans-wrap{padding:32px 0 60px;}
        .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:1140px;margin:0 auto;padding:0 22px;}
        .plan{background:#fff;border:1.5px solid #E5E0D8;border-radius:18px;padding:32px 26px;display:flex;flex-direction:column;transition:transform .18s ease, box-shadow .18s ease;}
        .plan:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.06);}
        .plan-featured{border-color:#E8670A;position:relative;background:linear-gradient(180deg,#FFF9F3 0%,#fff 55%);}
        .plan-ribbon{position:absolute;top:-13px;right:22px;background:#E8670A;color:#fff;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:5px 12px;border-radius:999px;}
        .plan-name{font-size:13px;font-weight:700;color:#5A564F;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;}
        .plan-price{display:flex;align-items:baseline;gap:6px;margin-bottom:6px;}
        .plan-price-amt{font-size:44px;font-weight:800;letter-spacing:-1px;color:#1A1814;}
        .plan-price-unit{color:#9A958C;font-size:14px;font-weight:600;}
        .plan-sub{font-size:13px;color:#5A564F;margin-bottom:22px;min-height:36px;}
        .plan-features{list-style:none;padding:0;margin:0 0 24px;flex:1;}
        .plan-features li{display:flex;gap:10px;padding:7px 0;font-size:14px;color:#1A1814;line-height:1.5;}
        .plan-features li::before{content:"\2713";color:#16A34A;font-weight:800;flex-shrink:0;}
        .plan-features li.muted{color:#9A958C;}
        .plan-features li.muted::before{content:"\2014";color:#D0CBC2;}
        .plan .mk-btn{width:100%;justify-content:center;}
        @@media (max-width:900px){ .plans{grid-template-columns:1fr;} }

        /* ── Compare table ── */
        .compare-wrap{background:#F7F5F2;padding:64px 0;}
        .compare{max-width:1000px;margin:0 auto;padding:0 22px;overflow-x:auto;}
        .compare table{width:100%;border-collapse:collapse;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,.04);}
        .compare th,.compare td{padding:14px 18px;text-align:left;font-size:14px;border-bottom:1px solid #E5E0D8;}
        .compare th{background:#1A1814;color:#fff;font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.8px;}
        .compare th:not(:first-child){text-align:center;}
        .compare td:not(:first-child){text-align:center;}
        .compare tr:last-child td{border-bottom:none;}
        .yes{color:#16A34A;font-weight:800;font-size:16px;}
        .no{color:#D0CBC2;font-size:16px;}
        .compare tr:hover td{background:#FFF9F3;}

        /* ── FAQ ── */
        .faq-wrap{padding:64px 0;}
        .faq{max-width:820px;margin:32px auto 0;}
        .faq details{background:#fff;border:1px solid #E5E0D8;border-radius:12px;padding:16px 18px;margin-bottom:10px;transition:box-shadow .15s ease;}
        .faq details[open]{box-shadow:0 4px 18px rgba(0,0,0,.06);}
        .faq summary{font-weight:700;font-size:15px;color:#1A1814;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px;}
        .faq summary::-webkit-details-marker{display:none;}
        .faq summary::after{content:"+";font-size:22px;color:#9A958C;flex-shrink:0;transition:transform .2s;}
        .faq details[open] summary::after{content:"\2212";}
        .faq details p{color:#5A564F;font-size:14px;line-height:1.6;margin-top:12px;}

        /* ── Final CTA ── */
        .sales-cta{background:linear-gradient(135deg,#1A1814 0%,#2D2820 100%);border-radius:22px;padding:56px 32px;color:#fff;text-align:center;position:relative;overflow:hidden;}
        .sales-cta::before{content:"";position:absolute;inset:-2px;background:radial-gradient(circle at 20% 20%,rgba(232,103,10,.35),transparent 50%);pointer-events:none;}
        .sales-cta h2{font-size:32px;font-weight:800;margin-bottom:10px;color:#fff;position:relative;}
        .sales-cta p{color:rgba(255,255,255,.75);max-width:560px;margin:0 auto 24px;font-size:16px;position:relative;}
        .sales-cta .mk-btn{position:relative;}
        .sales-cta .mk-btn-primary{background:#E8670A;color:#fff;}
        .sales-cta .mk-btn-primary:hover{background:#F5D87A;color:#1A1814;}
        .sales-cta .mk-btn-outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.4);}
        .sales-cta .mk-btn-outline:hover{background:rgba(255,255,255,.1);color:#fff;border-color:#fff;}
    </style>
}

<!-- ═════════════════ HERO ═════════════════ -->
<section class="pr-hero">
    <div class="mk-container">
        <span class="mk-pill">Pricing</span>
        <h1 class="mk-h1">Simple plans that scale with your city.</h1>
        <p class="mk-lead" style="margin-left:auto;margin-right:auto">
            Start free with a single Nigam. Scale to a full city, or roll it out state-wide.
            No per-pet fees &mdash; you own your data.
        </p>
        <div class="pr-toggle" role="tablist" aria-label="Billing cycle">
            <button id="tog-monthly" class="active" onclick="prSetBilling('monthly')">Monthly</button>
            <button id="tog-annual" onclick="prSetBilling('annual')">Annual &nbsp;&middot;&nbsp; save 20%</button>
        </div>
    </div>
</section>

<!-- ═════════════════ PLANS ═════════════════ -->
<section class="plans-wrap">
    <div class="plans">

        <!-- Free / Pilot -->
        <div class="plan">
            <div class="plan-name">Pilot</div>
            <div class="plan-price">
                <span class="plan-price-amt">&#x20B9;0</span>
                <span class="plan-price-unit">/ month</span>
            </div>
            <div class="plan-sub">Perfect for a single ward or a quick evaluation.</div>
            <ul class="plan-features">
                <li>1 Nigam &middot; up to 500 pets</li>
                <li>All citizen features</li>
                <li>Ward &amp; Nigam admin dashboards</li>
                <li>Digital certificates &amp; QR codes</li>
                <li>Community forum</li>
                <li class="muted">Custom domain</li>
                <li class="muted">SLA-backed support</li>
            </ul>
            <a class="mk-btn mk-btn-outline" href="/">Start free &rarr;</a>
        </div>

        <!-- City (featured) -->
        <div class="plan plan-featured">
            <span class="plan-ribbon">Most popular</span>
            <div class="plan-name">City</div>
            <div class="plan-price">
                <span class="plan-price-amt" id="price-city">&#x20B9;9,999</span>
                <span class="plan-price-unit" id="unit-city">/ month</span>
            </div>
            <div class="plan-sub">For a full municipal corporation with multiple Nigams.</div>
            <ul class="plan-features">
                <li>Unlimited Nigams, Zones &amp; Wards</li>
                <li>Up to 50,000 pets</li>
                <li>All roles: Ward &rarr; City Admin</li>
                <li>Per-Nigam fee configuration + audit</li>
                <li>Analytics &amp; billing reports</li>
                <li>Cloudinary media hosting</li>
                <li>Email &amp; chat support</li>
                <li class="muted">Custom branding &amp; domain</li>
            </ul>
            <a class="mk-btn mk-btn-primary" href="#contact-sales">Get City plan &rarr;</a>
        </div>

        <!-- Enterprise -->
        <div class="plan">
            <div class="plan-name">State / Enterprise</div>
            <div class="plan-price">
                <span class="plan-price-amt">Talk to us</span>
            </div>
            <div class="plan-sub">Multiple cities, state-wide rollouts, integrations &amp; SLAs.</div>
            <ul class="plan-features">
                <li>Unlimited cities, pets and users</li>
                <li>Custom branding &amp; sub-domains per city</li>
                <li>SSO / SAML integration</li>
                <li>Dedicated staging environment</li>
                <li>Data-residency options</li>
                <li>99.9% uptime SLA</li>
                <li>24&#x00D7;7 priority support</li>
                <li>On-premise deployment option</li>
            </ul>
            <a class="mk-btn mk-btn-dark" href="#contact-sales">Contact sales &rarr;</a>
        </div>

    </div>
</section>

<!-- ═════════════════ COMPARE TABLE ═════════════════ -->
<section class="compare-wrap">
    <div class="mk-container mk-center">
        <span class="mk-pill">Compare plans</span>
        <h2 class="mk-h2">Feature by feature</h2>
        <p class="mk-lead" style="margin-left:auto;margin-right:auto">
            All plans include unlimited citizens and the mobile app. You only pay for scale and support.
        </p>
    </div>
    <div class="compare">
        <table>
            <thead>
                <tr>
                    <th>Feature</th>
                    <th>Pilot</th>
                    <th>City</th>
                    <th>Enterprise</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Citizen web + mobile app</td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Digital licence certificates + QR</td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Community forum</td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Number of Nigams</td><td>1</td><td>Unlimited</td><td>Unlimited</td></tr>
                <tr><td>Pet cap</td><td>500</td><td>50,000</td><td>Unlimited</td></tr>
                <tr><td>Ward / Zone / Nigam admins</td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>City Admin role</td><td><span class="no">&mdash;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Per-Nigam fees + history audit</td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Analytics &amp; billing reports</td><td>Basic</td><td>Full</td><td>Full + exports</td></tr>
                <tr><td>Cloudinary media hosting</td><td>1 GB</td><td>50 GB</td><td>Custom</td></tr>
                <tr><td>Custom branding &amp; domain</td><td><span class="no">&mdash;</span></td><td><span class="yes">&#x2713;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>SSO / SAML</td><td><span class="no">&mdash;</span></td><td><span class="no">&mdash;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>On-premise / data residency</td><td><span class="no">&mdash;</span></td><td><span class="no">&mdash;</span></td><td><span class="yes">&#x2713;</span></td></tr>
                <tr><td>Support</td><td>Community</td><td>Email + chat</td><td>24&#x00D7;7 priority</td></tr>
                <tr><td>Uptime SLA</td><td>Best effort</td><td>99.5%</td><td>99.9%</td></tr>
            </tbody>
        </table>
    </div>
</section>

<!-- ═════════════════ FAQ ═════════════════ -->
<section class="mk-section faq-wrap" id="faq">
    <div class="mk-container mk-center">
        <span class="mk-pill">FAQ</span>
        <h2 class="mk-h2">Questions we hear often</h2>
    </div>
    <div class="faq">
        <details>
            <summary>Do citizens ever pay anything?</summary>
            <p>Citizens only pay the Registration, Renewal or Transfer fees your Nigam sets. Those fees are configured per Nigam and go directly to your municipal account via Razorpay. All For Pets does not take a cut of citizen payments.</p>
        </details>
        <details>
            <summary>Is there a per-pet or per-transaction fee?</summary>
            <p>No. Our plans are flat subscriptions based on scale (number of Nigams and pet cap). You keep 100% of the fees your citizens pay.</p>
        </details>
        <details>
            <summary>How long does onboarding take?</summary>
            <p>A pilot city can be live in under an hour: we seed your City &rarr; Nigam &rarr; Zone &rarr; Ward tree, create your Super Admin account, and you're ready to invite ward officers.</p>
        </details>
        <details>
            <summary>Do you support the mobile app on iOS?</summary>
            <p>Today the mobile app is Android (Capacitor + WebView). The web app works flawlessly on iOS Safari. An iOS wrapper is on the roadmap &mdash; it's the same codebase.</p>
        </details>
        <details>
            <summary>Can we brand the app with our city's colours and logo?</summary>
            <p>Custom branding (colours, logo, domain like <em>pets.jaipurnagarnigam.gov.in</em>) is included on the City plan and above.</p>
        </details>
        <details>
            <summary>Where is our data hosted?</summary>
            <p>The default deployment is on Railway (Mumbai region). Enterprise customers can choose data residency (India, EU, US) or on-premise deployment on their own infrastructure.</p>
        </details>
        <details>
            <summary>Is the code open source?</summary>
            <p>The source lives at <a href="https://github.com/Tapan520/AFP" rel="noopener">github.com/Tapan520/AFP</a>. Enterprise customers get a licence to modify and self-host.</p>
        </details>
        <details>
            <summary>How is per-Nigam fee editing audited?</summary>
            <p>Every fee change writes an append-only row to <code>nigam_fee_history</code> with old value, new value, who changed it, and when. Super Admins and Nigam Admins can view this history at any time from the Fees tab.</p>
        </details>
        <details>
            <summary>What payment gateway do you support?</summary>
            <p>Razorpay is built-in with a 3-tier fee fallback (per-Nigam &rarr; app config &rarr; hard-coded). Adding Stripe, PayU or your municipality's preferred gateway is straightforward on the Enterprise plan.</p>
        </details>
    </div>
</section>

<!-- ═════════════════ SALES CTA ═════════════════ -->
<section class="mk-section" id="contact-sales">
    <div class="mk-container">
        <div class="sales-cta">
            <h2>Ready to license every pet in your city?</h2>
            <p>Book a 30-minute demo and we'll walk you through a live pilot city &mdash; from citizen registration to Super Admin fee editing.</p>
            <div class="mk-btn-row" style="justify-content:center">
                <a class="mk-btn mk-btn-primary" href="mailto:hello@allforpets.in?subject=All%20For%20Pets%20-%20Demo%20request">&#x1F4E7; Book a demo</a>
                <a class="mk-btn mk-btn-outline" href="/">Try it free</a>
            </div>
            <div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:22px;position:relative">
                Prefer to write to us? <a style="color:#F5D87A" href="mailto:hello@allforpets.in">hello@allforpets.in</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    // Toggle monthly / annual pricing on the City card.
    // Numbers are illustrative; adjust with real pricing once finalised.
    const CITY_PRICES = { monthly: { amt: "\u20B99,999", unit: "/ month" },
                          annual:  { amt: "\u20B996,000", unit: "/ year" } };
    function prSetBilling(mode) {
        document.getElementById("tog-monthly").classList.toggle("active", mode === "monthly");
        document.getElementById("tog-annual" ).classList.toggle("active", mode === "annual");
        const p = CITY_PRICES[mode];
        document.getElementById("price-city").textContent = p.amt;
        document.getElementById("unit-city" ).textContent = p.unit;
    }
</script>
}
