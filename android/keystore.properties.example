# Template — copy to `keystore.properties` and fill in real values.
# The real file is git-ignored so credentials never reach the repo.
#
# Absolute path (or path relative to the android/ folder) to your release
# .jks / .keystore file. Example: afp-release.jks means the file lives at
# android/afp-release.jks.
storeFile=afp-release.jks
storePassword=CHANGE_ME
keyAlias=afp-release
keyPassword=CHANGE_ME
