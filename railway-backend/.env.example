# ????????????????????????????????????????????????????????????????
# .env.example — TEMPLATE for local development.
#
# This file is checked into git and used by dotenv-safe as the
# canonical list of REQUIRED env variables. If a variable is listed
# here (with or without a value), the app will refuse to boot when
# it is missing from the active .env file.
#
# Usage:
#   • Copy this file to `.env` (or `.env.development` / `.env.production`)
#   • Fill in real secrets
#   • Never commit `.env`, `.env.development`, `.env.production`
# ????????????????????????????????????????????????????????????????

# ?? Server ??????????????????????????????????????????????????????
NODE_ENV=development
PORT=3000

# ?? MySQL ???????????????????????????????????????????????????????
# Either use individual vars…
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=afp_nagarnigam
# …or a single URL. When both are present, DATABASE_URL wins.
DATABASE_URL=

# ?? JWT (rotate every 90 days in production) ????????????????????
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
MIGRATION_SECRET=change_me_for_run_migrations_endpoint

# ?? CORS ????????????????????????????????????????????????????????
CORS_ORIGIN=https://localhost:7207

# ?? File storage (see ./storage/index.js) ???????????????????????
# STORAGE_PROVIDER=local | s3 | azure | cloudinary
STORAGE_PROVIDER=local
# Public URL prefix used when returning uploaded file URLs.
# For local this is "/uploads", for the cloud providers it is the CDN URL.
PUBLIC_UPLOADS_BASE_URL=/uploads

# ?? AWS S3 (only required when STORAGE_PROVIDER=s3) ?????????????
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ?? Azure Blob (only required when STORAGE_PROVIDER=azure) ??????
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=

# ?? Cloudinary (only required when STORAGE_PROVIDER=cloudinary) ?
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ?? Backups (see ./storage/backup.js) ???????????????????????????
# Where mysqldump lives. Blank ? assume it's on PATH.
MYSQLDUMP_PATH=
# Where dumps are written. Also used for pruning.
BACKUP_DIR=./backups
# When true, backups also upload to the configured cloud storage.
BACKUP_UPLOAD_TO_CLOUD=false
# Retention (days). Files older than this are deleted after each dump.
BACKUP_RETENTION_DAYS=30
